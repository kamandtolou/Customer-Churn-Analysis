      <aliases enabled='yes' />
      <column caption='Member Status ' datatype='string' name='[Calculation_0220228093689856]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [IsActiveMember] = 1 THEN &quot;Active&quot;&#13;&#10;ELSE &quot;Inactive&quot;&#13;&#10;END' />
      </column>
      <column caption='Has Credit Card ' datatype='string' name='[Calculation_0220228098412545]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [HasCrCard] ==1 THEN &apos;Has CreditCard&apos;&#13;&#10;ELSE &apos;Doesnt have CreditCard&apos;&#13;&#10;END' />
      </column>
      <column caption='Credit Score Group' datatype='string' name='[Calculation_0680641561464832]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  [CreditScore] &gt;= 300 AND [CreditScore]&lt;= 499 THEN &apos;poor&apos;&#13;&#10;ELSEIF [CreditScore] &gt;= 500 AND [CreditScore]&lt;= 649 THEN &apos;fair&apos;&#13;&#10;ELSEIF [CreditScore]&gt;= 650 AND [CreditScore] &lt;= 749  THEN &apos;Good&apos;&#13;&#10;ELSEIF  [CreditScore] &gt;=750 AND  [CreditScore] &lt;= 850 THEN &apos;excellent&apos;&#13;&#10;ELSE &apos;&apos;&#13;&#10;END' />
      </column>
      <column caption='Balance Group' datatype='string' name='[Calculation_0680641562935297]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Balance] = 0 THEN &apos;zero&apos;&#13;&#10;ELSEIF [Balance] &lt; 50000 THEN &apos;low&apos;&#13;&#10;ELSEIF [Balance] &lt; 100000 THEN &apos;medium&apos;&#13;&#10;ELSE &apos;high&apos;&#13;&#10;END' />
      </column>
      <column caption='Tenure Group' datatype='string' name='[Calculation_0680641564979202]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Tenure] &gt;=0 AND [Tenure]&lt;=2 THEN &apos;New Customer&apos;&#13;&#10;ELSEIF [Tenure]&gt;=3 AND [Tenure]&lt;=5 THEN &apos;Mid-term customer&apos;&#13;&#10;ELSEIF [Tenure]&gt;=6 AND [Tenure]&lt;=8 THEN &apos;Loyal customer&apos;&#13;&#10;ELSE &apos;Long-term customer&apos;&#13;&#10;END' />
      </column>
      <column caption='Estimated Salary Group' datatype='string' name='[Calculation_0680641569796099]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [EstimatedSalary] &lt;= 50000 THEN &apos;low&apos;&#13;&#10;ELSEIF [EstimatedSalary] &gt; 50000 AND [EstimatedSalary]&lt;=100000 THEN &apos;good&apos;&#13;&#10;ELSE &apos;High&apos;&#13;&#10;END' />
      </column>
      <column caption='Churned Customers' datatype='integer' name='[Calculation_0915934210154497]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Exited]=1 THEN 1 ELSE 0 END' />
      </column>
      <column caption='Churned Rate' datatype='real' name='[Calculation_1477512610533376]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_0915934210154497])/COUNTD([CustomerId])' />
      </column>
      <column caption='Age Group ' datatype='string' name='[Calculation_1477512611282945]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Age] &gt;= 18 AND [Age] &lt;= 30 THEN &apos;18-30&apos;&#13;&#10;ELSEIF [Age] &gt;= 31 AND [Age] &lt;=40 THEN &apos;31-40&apos;&#13;&#10;ELSEIF [Age] &gt;= 41 AND  [Age] &lt;= 50 THEN &apos;41-50&apos;&#13;&#10;ELSE &apos;+50&apos;&#13;&#10;END' />
      </column>
      <column caption='Credit Score' datatype='integer' name='[CreditScore]' role='measure' type='quantitative' />
      <column caption='Customer Id' datatype='integer' name='[CustomerId]' role='measure' type='quantitative' />
      <column caption='Estimated Salary' datatype='real' name='[EstimatedSalary]' role='measure' type='quantitative' />
      <column aggregation='Sum' caption='Has Cr Card' datatype='integer' name='[HasCrCard]' role='dimension' type='ordinal' />
      <column aggregation='Sum' caption='Is Active Member' datatype='integer' name='[IsActiveMember]' role='dimension' type='ordinal' />
      <column aggregation='Sum' caption='Num Of Products' datatype='integer' name='[NumOfProducts]' role='dimension' type='ordinal' />
